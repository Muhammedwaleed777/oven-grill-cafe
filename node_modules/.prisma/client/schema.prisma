generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CHEF
  RIDER
  CASHIER
  CUSTOMER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

model User {
  id           String     @id @default(uuid())
  name         String
  phone        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(PENDING)
  lastLogin    DateTime?
  lastLogout   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Restaurant {
  id                String @id @default(uuid())
  name              String @default("Oven Grill Cafe")
  phone             String @default("")
  whatsappNumber    String @default("")
  address           String @default("")
  gstPercent        Float  @default(16)
  deliveryPerKmRate Float  @default(50)
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  menuItems MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}

model Deal {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  type          String // DINE_IN, TAKEAWAY, DELIVERY
  address       String?
  status        String      @default("PLACED")
  subtotal      Float
  gstAmount     Float
  total         Float
  paymentMethod String
  paymentStatus String      @default("PENDING")
  riderLat      Float? // 👈 Live Tracking Latitude
  riderLng      Float? // 👈 Live Tracking Longitude
  createdAt     DateTime    @default(now())
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String
  name       String
  price      Float
  qty        Int
  order      Order  @relation(fields: [orderId], references: [id])
}

model Payment {
  id         String   @id @default(uuid())
  orderId    String
  method     String
  amount     Float
  status     String   @default("PENDING")
  gatewayRef String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
}

model StockItem {
  id           String   @id @default(uuid())
  name         String
  quantity     Int
  unit         String
  minThreshold Int      @default(5)
  updatedAt    DateTime @updatedAt
}
